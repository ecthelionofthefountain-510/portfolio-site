---
import DemoLayout from "../../layouts/DemoLayout.astro";

// Påhittad frisörsalong – ren demo. Kontaktuppgifterna är platshållare.
const tjanster = [
  ["Klippning dam", "Tvätt, klippning, styling", "545"],
  ["Klippning herr", "Tvätt, klippning, styling", "445"],
  ["Klippning barn", "Under 12 år", "295"],
  ["Färg & slingor", "Pris efter håromfång", "från 1 195"],
  ["Toning", "Fräscha upp färgen", "från 695"],
  ["Styling & uppsättning", "Fest, bröllop, bal", "från 595"],
  ["Skägg & putsning", "Trimning och rakning", "250"],
];

const galleri = ["Klippning", "Balayage", "Styling", "Färg", "Uppsättning", "Herr"];

const oppet = [
  ["Mån–Fre", "09–18"],
  ["Lördag", "10–15"],
  ["Söndag", "Stängt"],
];
---

<DemoLayout
  title="Salong Sax — frisör i Ystad (demo)"
  description="Frisörsalong i Ystad. Klippning, färg och styling — boka tid online eller på telefon."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
  />

  <div class="site">
    <header class="top">
      <a href="#" class="brand">Salong<span>Sax</span></a>
      <nav class="nav">
        <a href="#tjanster">Tjänster</a>
        <a href="#galleri">Galleri</a>
        <a href="#oppet">Öppettider</a>
        <a href="#boka" class="btn btn--sm">Boka tid</a>
      </nav>
    </header>

    <section class="hero">
      <div class="hero__text">
        <p class="eyebrow">Frisör · Ystad</p>
        <h1>Din bästa hårdag,<br />varje gång</h1>
        <p class="lead">
          En liten salong med tid för dig. Klippning, färg och styling av
          frisörer som lyssnar först och klipper sen. Välkommen in.
        </p>
        <div class="hero__cta">
          <a href="#boka" class="btn">Boka tid</a>
          <a href="#tjanster" class="btn btn--ghost">Se priser</a>
        </div>
      </div>
      <div class="hero__img" role="img" aria-label="Bild från salongen">
        <span>Här ligger ett foto från salongen</span>
      </div>
    </section>

    <section id="tjanster" class="tjanster">
      <div class="section-head">
        <h2>Tjänster &amp; priser</h2>
        <p>Priserna är riktpriser — vi ger dig alltid en offert innan vi börjar.</p>
      </div>
      <ul class="prislista">
        {tjanster.map(([namn, desc, pris]) => (
          <li>
            <div class="prislista__top">
              <span class="prislista__namn">{namn}</span>
              <span class="prislista__pris">{pris} kr</span>
            </div>
            <p class="prislista__desc">{desc}</p>
          </li>
        ))}
      </ul>
    </section>

    <section id="galleri" class="galleri">
      <div class="section-head">
        <h2>Galleri</h2>
        <p>Ett urval av vad vi gör.</p>
      </div>
      <div class="galleri__grid">
        {galleri.map((etikett) => (
          <div class="tile" role="img" aria-label={`Exempelbild: ${etikett}`}>
            <span>{etikett}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="info">
      <div id="oppet" class="info__col">
        <h2>Öppettider</h2>
        <table class="oppet">
          <tbody>
            {oppet.map(([dag, tid]) => (
              <tr><th scope="row">{dag}</th><td>{tid}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="info__note">Drop-in i mån av tid — ring gärna först.</p>
      </div>
      <div class="info__col">
        <h2>Hitta hit</h2>
        <p class="info__addr">
          Långgatan 12<br />271 00 Ystad<br />
          <a href="tel:+4641100000">0411-00 00 00</a>
        </p>
        <div class="map" role="img" aria-label="Karta över salongens läge">
          <span>Karta med er plats</span>
        </div>
      </div>
    </section>

    <section id="boka" class="boka">
      <h2>Boka tid</h2>
      <p>Boka online dygnet runt, eller ring oss under öppettid.</p>
      <div class="boka__cta">
        <a href="#" class="btn btn--light">Boka online</a>
        <a href="tel:+4641100000" class="btn btn--ghost-light">Ring 0411-00 00 00</a>
      </div>
    </section>

    <footer class="foot">
      <div>
        <p class="foot__brand">Salong Sax</p>
        <p>Långgatan 12, 271 00 Ystad · 0411-00 00 00</p>
      </div>
      <p class="foot__demo">Påhittad salong — exempelsida, ingen riktig verksamhet.</p>
    </footer>
  </div>

  <style>
    .site {
      --bg: #f5f1ec;
      --paper: #faf7f3;
      --ink: #2c2723;
      --plum: #8a5a68;
      --plum-deep: #6f4553;
      --muted: #837b74;
      --line: #e7ded3;
      color: var(--ink);
      background: var(--bg);
      font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
      line-height: 1.6;
    }
    .site h1, .site h2, .site h3, .brand {
      font-family: "Poppins", ui-sans-serif, system-ui, sans-serif;
      font-weight: 600;
      letter-spacing: -0.01em;
    }

    /* Header */
    .top {
      display: flex; align-items: center; justify-content: space-between;
      gap: 1rem; flex-wrap: wrap;
      max-width: 1080px; margin: 0 auto; padding: 1.5rem 1.5rem;
    }
    .brand { font-size: 1.4rem; color: var(--ink); text-decoration: none; display: flex; align-items: baseline; gap: 0.35rem; }
    .brand span { color: var(--plum); }
    .nav { display: flex; align-items: center; gap: 1.5rem; }
    .nav > a:not(.btn) { color: var(--ink); text-decoration: none; font-size: 0.95rem; }
    .nav > a:not(.btn):hover { color: var(--plum); }

    /* Buttons */
    .btn {
      display: inline-block; background: var(--plum); color: #fff;
      padding: 0.85rem 1.5rem; border-radius: 999px; text-decoration: none;
      font-family: "Poppins", sans-serif; font-weight: 500; font-size: 0.92rem; transition: background 0.2s;
    }
    .btn:hover { background: var(--plum-deep); }
    .btn--sm { padding: 0.5rem 1.1rem; font-size: 0.88rem; }
    .btn--ghost { background: transparent; color: var(--plum); box-shadow: inset 0 0 0 1px var(--plum); }
    .btn--ghost:hover { background: rgba(138,90,104,0.07); }
    .btn--light { background: #fff; color: var(--plum-deep); }
    .btn--light:hover { background: #f2e9ec; }
    .btn--ghost-light { background: transparent; color: #fff; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.5); }
    .btn--ghost-light:hover { background: rgba(255,255,255,0.12); }

    /* Hero */
    .hero {
      max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem 4rem;
      display: grid; gap: 2.5rem; align-items: center;
    }
    @media (min-width: 800px) { .hero { grid-template-columns: 1.05fr 0.95fr; padding-top: 3rem; } }
    .eyebrow { text-transform: uppercase; letter-spacing: 0.18em; font-size: 0.76rem; color: var(--plum); font-weight: 600; font-family: "Poppins", sans-serif; }
    .hero h1 { font-size: clamp(2.4rem, 5.5vw, 3.7rem); line-height: 1.08; margin: 0.7rem 0 0; }
    .lead { font-size: 1.12rem; color: var(--muted); max-width: 36ch; margin-top: 1.25rem; }
    .hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 1.75rem; }
    .hero__img {
      aspect-ratio: 4/5; border-radius: 14px;
      background: linear-gradient(150deg, #b98a95, #8a5a68 55%, #6f4553);
      display: flex; align-items: flex-end; padding: 1.25rem; color: rgba(255,255,255,0.6); font-size: 0.85rem;
    }

    /* Tjänster */
    .tjanster { max-width: 820px; margin: 0 auto; padding: 3rem 1.5rem; }
    .section-head { text-align: center; margin-bottom: 2.5rem; }
    .section-head h2 { font-size: 2.1rem; }
    .section-head p { color: var(--muted); margin-top: 0.5rem; }
    .prislista { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.2rem; }
    .prislista li { border-bottom: 1px solid var(--line); padding-bottom: 1.2rem; }
    .prislista__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
    .prislista__namn { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 1.05rem; }
    .prislista__pris { color: var(--plum); font-weight: 600; white-space: nowrap; }
    .prislista__desc { color: var(--muted); font-size: 0.92rem; margin: 0.25rem 0 0; }

    /* Galleri */
    .galleri { background: var(--paper); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .galleri { padding: 3rem 1.5rem; }
    .galleri .section-head { max-width: 820px; margin: 0 auto 2.5rem; }
    .galleri__grid {
      max-width: 1080px; margin: 0 auto;
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.9rem;
    }
    @media (min-width: 720px) { .galleri__grid { grid-template-columns: repeat(3, 1fr); } }
    .tile {
      aspect-ratio: 1/1; border-radius: 12px;
      background: linear-gradient(150deg, #d8c2c8, #b98a95 60%, #8a5a68);
      display: flex; align-items: flex-end; padding: 0.9rem; color: rgba(255,255,255,0.78);
      font-family: "Poppins", sans-serif; font-size: 0.85rem; font-weight: 500;
    }
    .tile:nth-child(even) { background: linear-gradient(150deg, #c9b3ba, #9a6a7a 60%, #6f4553); }

    /* Info */
    .info { display: grid; gap: 2.5rem; max-width: 1080px; margin: 0 auto; padding: 3rem 1.5rem; }
    @media (min-width: 720px) { .info { grid-template-columns: 1fr 1fr; } }
    .info h2 { font-size: 1.7rem; margin-bottom: 1rem; }
    .oppet { width: 100%; border-collapse: collapse; max-width: 320px; }
    .oppet th, .oppet td { text-align: left; padding: 0.55rem 0; border-bottom: 1px solid var(--line); font-weight: 400; }
    .oppet td { text-align: right; color: var(--plum); font-weight: 600; }
    .info__note, .info__addr { color: var(--muted); margin-top: 1rem; }
    .info__addr a { color: var(--plum); }
    .map {
      margin-top: 1rem; aspect-ratio: 16/10; border-radius: 12px;
      background:
        repeating-linear-gradient(0deg, transparent 0 22px, rgba(138,90,104,0.06) 22px 23px),
        repeating-linear-gradient(90deg, transparent 0 22px, rgba(138,90,104,0.06) 22px 23px),
        #f0e9ea;
      display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 0.85rem;
    }

    /* Boka */
    .boka { background: var(--plum-deep); color: #fff; text-align: center; padding: 4rem 1.5rem; }
    .boka h2 { font-size: 2.1rem; }
    .boka p { color: rgba(255,255,255,0.8); margin-top: 0.5rem; }
    .boka__cta { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1.75rem; }

    /* Footer */
    .foot {
      max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem;
      display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
      font-size: 0.9rem; color: var(--muted);
    }
    .foot__brand { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 1.1rem; color: var(--ink); }
    .foot__demo { font-style: italic; }
  </style>
</DemoLayout>
