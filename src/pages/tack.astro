---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Tack — Kevin, webbutveckling i Ystad"
  description="Tack för ditt meddelande. Jag återkommer så snart jag kan."
>
  <section class="mx-auto max-w-2xl px-5 pt-16 pb-24">
    <h1 class="text-4xl sm:text-5xl font-bold leading-[1.1]">
      Tack, jag har fått ditt meddelande!
    </h1>
    <p class="mt-6 text-lg leading-[1.7] text-ink-soft">
      Jag återkommer så snart jag kan, oftast inom ett dygn. Vill du lägga till
      något kan du bara svara på mejlet du får.
    </p>
    <a href="/" class="inline-block mt-8 bg-ink text-chalk font-display px-6 py-3 hover:bg-ink-soft transition-colors">
      Tillbaka till startsidan
    </a>
  </section>
</BaseLayout>
