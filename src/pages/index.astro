---
import BaseLayout from "../layouts/BaseLayout.astro";

const tjanster = [
  {
    namn: "Start",
    pris: "9 900 kr",
    text: "En sida som svarar på det kunderna googlar: var ni ligger, när ni har öppet, hur de når er.",
  },
  {
    namn: "Standard",
    pris: "18 900 kr",
    text: "Flera sidor för dig som har mer att visa — meny, tjänster, bilder och text som säljer.",
  },
  {
    namn: "Utökad",
    pris: "från 34 900 kr",
    text: "När sidan ska göra något: bordsbokning, beställning online, redigering du sköter själv.",
  },
];

const steg = [
  {
    nr: "01",
    rubrik: "Vi pratar ihop oss",
    text: "Du berättar om verksamheten. Jag återkommer med ett förslag och ett fast pris — kostar ingenting.",
  },
  {
    nr: "02",
    rubrik: "Jag bygger",
    text: "Du får se sidan växa fram och säger till om något ska ändras. Priset står fast hela vägen.",
  },
  {
    nr: "03",
    rubrik: "Sidan går live",
    text: "Domän, publicering och Google Företagsprofil ingår. Sen sköter jag driften — eller du, om du vill.",
  },
];
---

<BaseLayout
  title="Kevin — handgjorda hemsidor för småföretag i Skåne"
  description="Handgjorda, snabba hemsidor för småföretag i Ystad och Skåne. Fast pris från 9 900 kr, klart på en vecka. Drift och underhåll för 349 kr i månaden."
>
  <!-- Hero -->
  <div class="hero-ambient">
    <section class="mx-auto max-w-6xl px-5 pt-12 pb-24 lg:pt-20 lg:pb-28 grid gap-14 lg:grid-cols-[1fr_0.85fr] lg:items-center">
      <div>
        <p data-reveal class="text-raps uppercase tracking-[0.25em] text-xs font-semibold">
          Webbutveckling i Ystad
        </p>
        <h1 data-reveal style="--reveal-delay: 0.08s" class="mt-6 text-5xl sm:text-6xl lg:text-7xl leading-[1.08]">
          Handgjorda hemsidor med personlighet.
        </h1>
        <hr data-reveal style="--reveal-delay: 0.16s" class="gold-rule mt-8" />
        <p data-reveal style="--reveal-delay: 0.22s" class="mt-8 max-w-md text-lg leading-[1.75] text-ink-soft">
          Många småföretag har bara en Facebook-sida. Jag bygger riktiga hemsidor
          som syns på Google, funkar i mobilen och gör att folk kan hitta, ringa
          och boka dig — till ett fast pris du får veta i förväg.
        </p>
        <div data-reveal style="--reveal-delay: 0.4s" class="mt-10 flex flex-wrap gap-4">
          <a href="/kontakt" class="inline-block bg-raps text-on-raps font-display px-6 py-3 hover:bg-raps-deep transition-colors">
            Hör av dig
          </a>
          <a href="/tjanster" class="inline-block border border-raps text-raps font-display px-6 py-3 hover:bg-raps hover:text-on-raps transition-colors">
            Se priser
          </a>
        </div>
      </div>

      <!-- Live-mockup av en demo (visar riktigt jobb, löser bildbristen) -->
      <div data-reveal style="--reveal-delay: 0.35s" class="hidden lg:block hero-mockup-wrap">
        <div class="hero-mockup rounded-xl border border-sand bg-surface overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-sand">
            <span class="w-3 h-3 rounded-full bg-ink-soft/40"></span>
            <span class="w-3 h-3 rounded-full bg-ink-soft/40"></span>
            <span class="w-3 h-3 rounded-full bg-ink-soft/40"></span>
            <span class="ml-3 text-xs text-ink-soft">exempel · restaurang</span>
          </div>
          <div class="relative overflow-hidden" style="height: 440px;">
            <iframe
              src="/demo/restaurang"
              title="Exempelsida: restaurang"
              loading="lazy"
              tabindex="-1"
              aria-hidden="true"
              class="absolute top-0 left-0 origin-top-left pointer-events-none border-0"
              style="width: 1180px; height: 1000px; transform: scale(0.47);"
            ></iframe>
          </div>
        </div>
        <p class="mt-4 text-center text-sm text-ink-soft">
          En av mina demosidor — <a href="/arbeten" class="text-raps hover:text-raps-deep underline underline-offset-4">se fler arbeten</a>
        </p>
      </div>
    </section>
  </div>

  <!-- Tjänster i korthet -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p data-reveal class="text-raps uppercase tracking-[0.25em] text-xs font-semibold">Paket</p>
    <h2 data-reveal style="--reveal-delay: 0.06s" class="mt-3 text-3xl sm:text-4xl">Tre sätt att komma igång</h2>
    <ul data-reveal style="--reveal-delay: 0.12s" class="mt-10 border-t border-sand">
      {tjanster.map((t) => (
        <li class="border-b border-sand py-8 grid gap-4 md:grid-cols-[16rem_1fr] md:items-baseline">
          <div>
            <h3 class="text-2xl">{t.namn}</h3>
            <p class="font-display text-2xl text-raps mt-1">{t.pris}</p>
          </div>
          <p class="text-lg leading-[1.75] max-w-xl text-ink-soft">{t.text}</p>
        </li>
      ))}
    </ul>
    <a href="/tjanster" class="inline-block mt-8 text-raps hover:text-raps-deep transition-colors underline underline-offset-4">
      Se allt som ingår och drift för 349 kr/mån →
    </a>
  </section>

  <!-- Så går det till -->
  <section class="mx-auto max-w-6xl px-5 py-16">
    <p data-reveal class="text-raps uppercase tracking-[0.25em] text-xs font-semibold">Så går det till</p>
    <h2 data-reveal style="--reveal-delay: 0.06s" class="mt-3 text-3xl sm:text-4xl">Från idé till live</h2>
    <div class="mt-12 grid gap-10 sm:grid-cols-3">
      {steg.map((s, i) => (
        <div data-reveal style={`--reveal-delay: ${0.1 + i * 0.08}s`}>
          <p class="font-display text-5xl text-raps">{s.nr}</p>
          <hr class="gold-rule mt-4 mb-5 opacity-60" />
          <h3 class="text-xl">{s.rubrik}</h3>
          <p class="mt-3 leading-[1.75] text-ink-soft">{s.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-5 py-8">
    <div data-reveal class="border border-sand bg-surface p-10 sm:p-16 text-center">
      <h2 class="text-3xl sm:text-4xl max-w-2xl mx-auto leading-[1.15]">
        Berätta om din verksamhet så skissar jag på ett förslag
      </h2>
      <p class="mt-5 max-w-xl mx-auto leading-[1.75] text-ink-soft">
        Några meningar räcker. Du får ett pris och en tidsplan tillbaka — utan
        att det binder dig till något.
      </p>
      <a href="/kontakt" class="inline-block mt-9 bg-raps text-on-raps font-display px-6 py-3 hover:bg-raps-deep transition-colors">
        Hör av dig
      </a>
    </div>
  </section>
</BaseLayout>
