---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/logo-lundstedt.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: "/tjanster", label: "Tjänster & priser" },
  { href: "/arbeten", label: "Arbeten" },
  { href: "/om-mig", label: "Om mig" },
  { href: "/kontakt", label: "Kontakt" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- TILLFÄLLIGT: håller sidan borta från Google medan den färdigställs.
         Ta bort denna rad (och säg till mig) när sidan ska bli sökbar. -->
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      // Markera att JS är på — scroll-reveal döljer bara element när detta finns.
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="sv_SE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#innehall" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-raps focus:text-on-raps focus:px-4 focus:py-2">Hoppa till innehåll</a>

    <header class="site-header">
      <div class="mx-auto max-w-6xl px-5 py-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-3">
        <a href="/" class="header-brand inline-flex items-center" aria-label="Kevin Lundstedt — till startsidan">
          <Image
            src={logo}
            alt="Kevin Lundstedt"
            width={434}
            height={200}
            class="h-12 sm:h-14 w-auto"
          />
        </a>
        <nav aria-label="Huvudmeny">
          <ul class="flex flex-wrap items-center gap-x-7 gap-y-1 text-[0.95rem]">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? "page" : undefined}
                   class={path === item.href
                     ? "text-raps"
                     : "text-ink-soft hover:text-raps transition-colors"}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="innehall" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-24">
      <div class="mx-auto max-w-6xl px-5 py-14 flex flex-col gap-6 sm:flex-row sm:justify-between sm:items-end">
        <div>
          <Image src={logo} alt="Kevin Lundstedt" width={434} height={200} class="h-16 w-auto" />
          <p class="text-sm footer-muted mt-4">Handgjorda hemsidor för småföretag i Skåne.</p>
        </div>
        <div class="text-sm sm:text-right">
          <p><a href="mailto:lundstedtkevin@gmail.com" class="text-ink hover:text-raps transition-colors underline underline-offset-4">lundstedtkevin@gmail.com</a></p>
          <p class="footer-muted mt-2">© {year} · Ystad</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Scroll-edge: tona in headerns skugga/linje först när sidan scrollats.
      (() => {
        const header = document.querySelector(".site-header");
        if (!header) return;
        const sync = () => header.classList.toggle("scrolled", window.scrollY > 4);
        sync();
        window.addEventListener("scroll", sync, { passive: true });
      })();
    </script>

    <script is:inline>
      // Startsidan: dölj header-loggan medan den stora hero-loggan syns,
      // tona in den när hero-loggan scrollats förbi (undviker dubbel logga).
      (() => {
        const header = document.querySelector(".site-header");
        const heroLogo = document.querySelector(".hero-logo");
        if (!header || !heroLogo || !("IntersectionObserver" in window)) return;
        header.classList.add("hide-brand");
        const io = new IntersectionObserver(
          ([e]) => header.classList.toggle("hide-brand", e.isIntersecting),
          { rootMargin: "-70px 0px 0px 0px", threshold: 0 }
        );
        io.observe(heroLogo);
      })();
    </script>

    <script is:inline>
      // Scroll-reveal: tona in [data-reveal]-element när de når vyn.
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll("[data-reveal]");
        if (reduce || !("IntersectionObserver" in window) || !els.length) {
          els.forEach((el) => el.classList.add("revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
        // Säkerhetsnät: inget innehåll får fastna osynligt om IO aldrig triggar.
        setTimeout(() => els.forEach((el) => el.classList.add("revealed")), 2500);
      })();
    </script>
  </body>
</html>
