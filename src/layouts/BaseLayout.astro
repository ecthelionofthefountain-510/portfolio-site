---
import "../styles/global.css";
import { Image } from "astro:assets";
import logo from "../assets/logo-lundstedt.png";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const nav = [
  { href: "/tjanster", label: "Tjänster & priser" },
  { href: "/arbeten", label: "Arbeten" },
  { href: "/om-mig", label: "Om mig" },
  { href: "/kontakt", label: "Kontakt" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- TILLFÄLLIGT: håller sidan borta från Google medan den färdigställs.
         Ta bort denna rad (och säg till mig) när sidan ska bli sökbar. -->
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>
      // Markera att JS är på — scroll-reveal döljer bara element när detta finns.
      document.documentElement.classList.add("js");
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="sv_SE" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
  </head>

  <body class="min-h-screen flex flex-col">
    <a href="#innehall" class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:bg-raps focus:text-on-raps focus:px-4 focus:py-2">Hoppa till innehåll</a>

    <header class="site-header">
      <div class="mx-auto max-w-6xl px-5 py-6 flex items-center justify-between gap-x-8">
        <a href="/" class="inline-flex items-center" aria-label="Kevin Lundstedt — till startsidan">
          <Image
            src={logo}
            alt="Kevin Lundstedt"
            width={520}
            height={240}
            class="h-16 sm:h-20 lg:h-24 w-auto"
          />
        </a>

        <nav class="hidden md:block" aria-label="Huvudmeny">
          <ul class="flex items-center gap-x-8 font-display text-[1.05rem]">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path === item.href ? "page" : undefined}
                   class={path === item.href
                     ? "text-raps"
                     : "text-ink hover:text-raps transition-colors"}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <button id="meny-knapp" type="button"
                class="md:hidden -mr-2 p-2 text-ink hover:text-raps transition-colors"
                aria-label="Öppna meny" aria-expanded="false" aria-controls="mobil-meny">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobilmeny (helskärm) -->
    <div id="mobil-meny" class="mobil-meny" aria-hidden="true">
      <div class="mx-auto max-w-6xl w-full px-5 py-6 flex items-center justify-end">
        <button id="meny-stang" type="button"
                class="-mr-2 p-2 text-ink hover:text-raps transition-colors" aria-label="Stäng meny">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </div>
      <nav class="flex-1 flex items-center justify-center" aria-label="Mobilmeny">
        <ul class="flex flex-col items-center gap-8 font-display text-3xl">
          {nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? "page" : undefined}
                 class={path === item.href ? "text-raps" : "text-ink hover:text-raps transition-colors"}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <main id="innehall" class="flex-1">
      <slot />
    </main>

    <footer class="site-footer mt-24">
      <div class="mx-auto max-w-6xl px-5 py-14 flex flex-col gap-6 sm:flex-row sm:justify-between sm:items-end">
        <div>
          <Image src={logo} alt="Kevin Lundstedt" width={434} height={200} class="h-16 w-auto" />
          <p class="text-sm footer-muted mt-4">Handgjorda hemsidor för småföretag i Skåne.</p>
        </div>
        <div class="text-sm sm:text-right">
          <p><a href="mailto:lundstedtkevin@gmail.com" class="text-ink hover:text-raps transition-colors underline underline-offset-4">lundstedtkevin@gmail.com</a></p>
          <p class="footer-muted mt-2">© {year} · Ystad</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Mobilmeny: öppna/stäng helskärmsmenyn.
      (() => {
        const btn = document.getElementById("meny-knapp");
        const menu = document.getElementById("mobil-meny");
        const close = document.getElementById("meny-stang");
        if (!btn || !menu) return;
        const open = () => {
          menu.classList.add("open");
          menu.setAttribute("aria-hidden", "false");
          btn.setAttribute("aria-expanded", "true");
          document.body.style.overflow = "hidden";
        };
        const shut = () => {
          menu.classList.remove("open");
          menu.setAttribute("aria-hidden", "true");
          btn.setAttribute("aria-expanded", "false");
          document.body.style.overflow = "";
        };
        btn.addEventListener("click", open);
        if (close) close.addEventListener("click", shut);
        menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", shut));
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && menu.classList.contains("open")) shut();
        });
      })();
    </script>

    <script is:inline>
      // Scroll-reveal: tona in [data-reveal]-element när de når vyn.
      (() => {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        const els = document.querySelectorAll("[data-reveal]");
        if (reduce || !("IntersectionObserver" in window) || !els.length) {
          els.forEach((el) => el.classList.add("revealed"));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("revealed");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
        // Säkerhetsnät: inget innehåll får fastna osynligt om IO aldrig triggar.
        setTimeout(() => els.forEach((el) => el.classList.add("revealed")), 2500);
      })();
    </script>
  </body>
</html>
